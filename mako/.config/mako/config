# Colors

background-color=#0a0a0a
text-color=#ff8ba8
border-color=#ff0055
progress-color=over #ff005550
border-radius=0
border-size=2

# Layout
width=400
height=150
margin=10
padding=15,20
anchor=top-right

# Font (use uma monospace)
font=JetBrainsMono Nerd Font 10

# Icons
icons=1
max-icon-size=32
icon-location=left

# Behavior
default-timeout=5000
format=<b>[ %s ]</b>\n<span font_family="monospace">» %b</span>

[urgency=low]
border-color=#ff00557e
text-color=#ff8ba8aa
default-timeout=3000

[urgency=normal]
border-color=#ff0055
text-color=#ff8ba8

[urgency=high]
border-color=#ff3270
text-color=#ff3270
background-color=#1a0008
default-timeout=0